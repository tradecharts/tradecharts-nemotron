# Fill from your own secrets store. Never commit .env. Never paste keys into chat, code, or logs.

# Nebius Token Factory (hackathon-compliant path - the submitted demo runs on this)
NEBIUS_API_KEY=

# NVIDIA integrate (dev / tests / desk BYOK feature) - NOT the hackathon submission path
NVIDIA_API_KEY=

# Which provider the CLI uses by default (nebius | nvidia)
WAVECOUNT_PROVIDER=nebius
